// Prisma Schema for Voyagr - Boutique Travel Advisor Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// Note: SQLite does not support enums. Values are stored as strings.
// UserRole: ADMIN | ADVISOR | CLIENT
// LeadStatus: NEW | CONTACTED | PLANNING | PROPOSAL_SENT | BOOKED | COMPLETED | ARCHIVED
// TravelStyle: LUXURY | ADVENTURE | CULTURAL | ROMANTIC | FAMILY | SOLO | WELLNESS | FOODIE | SCENIC | BUDGET
// BudgetRange: UNDER_3K | THREE_TO_5K | FIVE_TO_10K | TEN_TO_20K | OVER_20K
// TravelerType: COUPLE | SOLO | FAMILY_YOUNG_KIDS | FAMILY_TEENS | GROUP_FRIENDS | MULTI_GEN | HONEYMOON | ANNIVERSARY
// PlaceCategory: HOTEL | RESORT | BOUTIQUE_HOTEL | VILLA | RESTAURANT | CAFE | BAR | EXPERIENCE | ACTIVITY | TOUR | SPA | BEACH | LANDMARK
// KnowledgeCategory: GENERAL | BEST_TIME_TO_VISIT | NEIGHBORHOODS | TRANSPORTATION | FOOD_CULTURE | HIDDEN_GEMS | LUXURY_TIPS | FAMILY_TIPS | ROMANCE_TIPS | ADVENTURE_TIPS
// ProposalStatus: DRAFT | SENT | VIEWED | ACCEPTED | DECLINED | REVISED
// TemplateStatus: ACTIVE | DRAFT | ARCHIVED
// PortalStatus: DRAFT | PUBLISHED | UNPUBLISHED
// ChecklistCategory: PRE_TRIP | DURING_TRIP | POST_TRIP | DAY_ACTIVITY

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("ADVISOR") // UserRole: ADMIN | ADVISOR | CLIENT
  password  String
  avatar    String?
  bio       String?
  leadId    String?  @unique // Links CLIENT users to their CustomerLead
  inviteToken   String?  @unique // One-time token for password setup
  tokenExpiresAt DateTime? // Token expiry
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklistCompletions ChecklistCompletion[]

  @@map("users")
}

model CustomerLead {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String?
  status    String   @default("NEW") // LeadStatus
  source    String?  @default("website")
  tags      String?  // JSON array stored as string
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  survey          TripSurvey?
  summary         GeneratedTravelerSummary?
  tripVersions    TripVersion[]
  proposals       Proposal[]
  portalPage      ClientPortalPage?
  leadNotes       LeadNote[]

  @@map("customer_leads")
}

model TripSurvey {
  id       String @id @default(cuid())
  leadId   String @unique
  lead     CustomerLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  travelerType       String?
  groupSize          Int?
  childrenAges       String?
  tripDurationMin    Int?
  tripDurationMax    Int?
  tripYear           Int?
  tripMonths         String?
  budget             String?
  budgetFlexible     Boolean @default(false)
  destinationsKnown  Boolean @default(false)
  destinationsList   String?
  destinationOpenTo  String?
  openToSuggestions  Boolean @default(true)
  travelStyles       String?
  pacePreference     String?
  accommodationType  String?
  interests          String?
  mustHaveExperiences String?
  avoidExperiences   String?
  diningImportance   Int?
  dietaryRestrictions String?
  diningStyle        String?
  countriesVisited   String?
  favoriteTrip       String?
  worstTripAspect    String?
  celebrationDetails String?
  accessibilityNeeds String?
  otherRequests      String?
  planningInvolvement String?
  communicationPref  String?
  tripFeeling        String?
  oneWord            String?
  submittedAt DateTime @default(now())

  @@map("trip_surveys")
}

model GeneratedTravelerSummary {
  id       String @id @default(cuid())
  leadId   String @unique
  lead     CustomerLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  travelerSummary        String
  idealTripStyle         String
  bestFitDestinations    String
  pacingRecommendation   String
  routeSuggestion        String?
  hotelStyle             String
  diningFocus            String
  activitiesRecommended  String
  avoidPatterns          String
  advisorNotes           String
  matchingTemplates      String
  generatedAt DateTime @default(now())

  @@map("generated_traveler_summaries")
}

model LeadNote {
  id        String @id @default(cuid())
  leadId    String
  lead      CustomerLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content   String
  author    String
  createdAt DateTime @default(now())

  @@map("lead_notes")
}

model TripVersion {
  id       String @id @default(cuid())
  leadId   String
  lead     CustomerLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  versionNumber  Int
  title          String
  summary        String
  destinations   String
  durationDays   Int
  estimatedCost  Float?
  itinerary      String
  hotelIdeas     String
  experiences    String
  notes          String?
  status         String @default("draft")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposal Proposal?

  @@map("trip_versions")
}

model Proposal {
  id            String @id @default(cuid())
  leadId        String
  lead          CustomerLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  versionId     String?      @unique
  version       TripVersion? @relation(fields: [versionId], references: [id])

  title         String
  status        String @default("DRAFT") // ProposalStatus

  introMessage  String
  itinerarySummary String
  pricing       String
  inclusions    String
  exclusions    String
  termsNotes    String?
  advisorSignOff String?

  sentAt        DateTime?
  viewedAt      DateTime?
  respondedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portalPage ClientPortalPage?

  @@map("proposals")
}

model ClientPortalPage {
  id         String @id @default(cuid())
  leadId     String @unique
  lead       CustomerLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  proposalId String? @unique
  proposal   Proposal? @relation(fields: [proposalId], references: [id])

  slug       String @unique
  title      String
  isActive   Boolean @default(true)

  // Publishing
  portalStatus   String  @default("DRAFT") // DRAFT | PUBLISHED | UNPUBLISHED
  publishedAt    DateTime?
  visibleSections String? // JSON array of section names shown to customer

  // Travel dates for progress tracking
  travelStartDate DateTime?
  travelEndDate   DateTime?

  heroImageUrl   String?
  welcomeMessage String
  tripHighlights String // JSON array
  advisorMessage String? // personal message from advisor

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklistItems ChecklistItem[]

  @@map("client_portal_pages")
}

// ==================== CHECKLIST SYSTEM ====================

model ChecklistTemplate {
  id          String @id @default(cuid())
  name        String // e.g. "International Trip Prep", "Honeymoon Travel Prep"
  description String?
  category    String // PRE_TRIP | DURING_TRIP | general
  items       String // JSON array of { title, description, category, dayNumber? }
  isDefault   Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("checklist_templates")
}

model ChecklistItem {
  id          String @id @default(cuid())
  portalId    String
  portal      ClientPortalPage @relation(fields: [portalId], references: [id], onDelete: Cascade)

  title       String
  description String?
  category    String  @default("PRE_TRIP") // PRE_TRIP | DURING_TRIP | POST_TRIP | DAY_ACTIVITY
  dayNumber   Int?    // which itinerary day this belongs to (null = general)
  sortOrder   Int     @default(0)

  isCustomerVisible Boolean @default(true)
  isRequired        Boolean @default(false)
  isGenerated       Boolean @default(false) // true if auto-generated, false if custom/edited

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completions ChecklistCompletion[]

  @@map("checklist_items")
}

model ChecklistCompletion {
  id          String @id @default(cuid())
  itemId      String
  item        ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  completed   Boolean @default(true)
  notes       String?
  completedAt DateTime @default(now())

  @@unique([itemId, userId])
  @@map("checklist_completions")
}

// ==================== EXISTING MODELS (UNCHANGED) ====================

model ItineraryTemplate {
  id          String @id @default(cuid())
  title       String
  destination String
  country     String
  region      String?
  flagEmoji   String?
  summary     String
  description String
  durationDays    Int
  travelStyles    String
  travelerTypes   String
  budgetLevel     String
  paceLevel       String
  tags            String?
  status          String @default("ACTIVE")
  isFeatured      Boolean @default(false)
  isBestSeller    Boolean @default(false)
  isSignature     Boolean @default(false)
  imageUrl        String?
  mapImageUrl     String?
  bestMonths      String?
  highlights      String
  includes        String
  excludes        String?
  basePrice       Float?
  priceNotes      String?
  days            TemplateDay[]
  collections     TripCollectionItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("itinerary_templates")
}

model TemplateDay {
  id          String @id @default(cuid())
  templateId  String
  template    ItineraryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dayNumber   Int
  title       String
  location    String
  description String
  activities  String
  meals       String?
  accommodation String?
  transportNotes String?
  tips        String?

  @@map("template_days")
}

model PastTrip {
  id          String @id @default(cuid())
  title       String
  destination String
  country     String
  flagEmoji   String?
  clientName  String
  tripDate    String
  durationDays Int
  summary     String
  highlights  String
  travelStyle String
  travelerType String
  budgetLevel String
  testimonial String?
  rating      Int?
  imageUrl    String?
  advisorNotes String?
  templateId  String?
  createdAt DateTime @default(now())

  @@map("past_trips")
}

model TripCollection {
  id          String @id @default(cuid())
  title       String
  description String
  coverImageUrl String?
  emoji       String?
  isPublic    Boolean @default(true)
  sortOrder   Int @default(0)
  items       TripCollectionItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trip_collections")
}

model TripCollectionItem {
  id           String @id @default(cuid())
  collectionId String
  collection   TripCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  templateId   String
  template     ItineraryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sortOrder    Int @default(0)

  @@unique([collectionId, templateId])
  @@map("trip_collection_items")
}

model DestinationKnowledgeEntry {
  id          String @id @default(cuid())
  destination String
  country     String
  region      String?
  flagEmoji   String?
  category    String
  title       String
  content     String
  tags        String?
  isFeatured  Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seasonalityNotes SeasonalityNote[]

  @@map("destination_knowledge_entries")
}

model SeasonalityNote {
  id            String @id @default(cuid())
  destinationId String
  destination   DestinationKnowledgeEntry @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  month         Int
  rating        Int
  notes         String
  crowds        String
  weather       String

  @@map("seasonality_notes")
}

model SavedPlace {
  id          String @id @default(cuid())
  name        String
  destination String
  country     String
  flagEmoji   String?
  category    String
  description String
  priceLevel  Int?
  rating      Float?
  address     String?
  website     String?
  whyWeRecommend String
  bestFor     String?
  imageUrl    String?
  tags        String?
  isFeatured  Boolean @default(false)
  isTopPick   Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("saved_places")
}

model PricingEstimate {
  id          String @id @default(cuid())
  destination String
  durationDays Int
  travelerType String
  budgetLevel  String
  flightMin    Float
  flightMax    Float
  hotelPerNightMin Float
  hotelPerNightMax Float
  diningPerDayMin  Float
  diningPerDayMax  Float
  activitiesTotal  Float?
  transfersTotal   Float?
  totalMin     Float
  totalMax     Float
  notes        String?
  lastUpdated  DateTime @default(now())

  @@map("pricing_estimates")
}

model EmailTemplate {
  id       String @id @default(cuid())
  name     String
  subject  String
  category String
  bodyHtml String
  bodyText String
  variables String?
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

model BusinessSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  type  String @default("string")
  label       String?
  description String?
  group       String?
  updatedAt DateTime @updatedAt

  @@map("business_settings")
}
